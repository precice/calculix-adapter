<?xml version="1.0" encoding="UTF-8"?>
<precice-configuration>
  <data:vector name="Displacement" />
  <mesh name="Solid-Nodes" dimensions="3">
    <use-data name="Displacement" />
  </mesh>
  <mesh name="Tets" dimensions="3" />
  <mesh name="Hexes" dimensions="3" />
  <participant name="Solid">
    <provide-mesh name="Solid-Nodes" />
    <provide-mesh name="Tets" />
    <provide-mesh name="Hexes" />
    <write-data name="Displacement" mesh="Solid-Nodes" />
  </participant>
  <participant name="Probe">
    <receive-mesh name="Solid-Nodes" from="Solid" api-access="true" />
    <receive-mesh name="Tets" from="Solid" api-access="true" />
    <receive-mesh name="Hexes" from="Solid" api-access="true" />
    <read-data name="Displacement" mesh="Solid-Nodes" />
  </participant>
  <m2n:sockets acceptor="Solid" connector="Probe" exchange-directory="." />
  <coupling-scheme:serial-explicit>
    <participants first="Solid" second="Probe" />
    <time-window-size value="1" />
    <max-time-windows value="1" />
    <exchange data="Displacement" mesh="Solid-Nodes" from="Solid" to="Probe" />
  </coupling-scheme:serial-explicit>
</precice-configuration>
